# 설치: sudo cp deploy/policy-pay-notify-listener.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now policy-pay-notify-listener

[Unit]
Description=policy_pay (Allowance) devnet PaymentExecuted -> Telegram notify listener
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/policy-pay/app
EnvironmentFile=/var/www/policy-pay/app/.env.production
ExecStart=/usr/bin/npm run notify-listener
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
